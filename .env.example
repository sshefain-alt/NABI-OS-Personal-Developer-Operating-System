# Optional: enables real email delivery from the Contact app.
# Without these values the contact form falls back to a mailto/copy flow.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "NABI OS <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Used for canonical metadata / sitemap. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
